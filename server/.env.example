# Port for Express API
PORT=5000

# PostgreSQL Connection String (Render / Supabase / Neon / Local PostgreSQL)
# Example: postgresql://username:password@hostname:5432/databasename?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/alok_portfolio?schema=public

# Allowed Frontend URL for Production CORS (e.g., https://alok-portfolio.vercel.app)
FRONTEND_URL=http://localhost:5173

# Node Environment
NODE_ENV=development
